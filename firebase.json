{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    }
  },
  "apphosting": [
    {
      "backendId": "lifeos",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "firestore-debug.log",
        "test-results",
        "playwright-report",
        "tests",
        ".env.local",
        ".env.emulators"
      ]
    }
  ],
  "hosting": {
    "site": "lifeapp-nikol",
    "public": "hosting",
    "ignore": [
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "lifeos",
          "region": "europe-west4"
        }
      }
    ]
  }
}
