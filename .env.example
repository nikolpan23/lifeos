# Copy to .env.local and fill in from YOUR Firebase project:
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration (Config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server credentials for local development only (never commit this value).
# Firebase console -> Project settings -> Service accounts -> Generate new private key,
# then paste the whole JSON on one line. Not needed on App Hosting.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional: Claude-powered daily plans. Leave empty to use the rule-based planner only.
ANTHROPIC_API_KEY=
# Optional: override the model and the per-user daily limit.
ANTHROPIC_MODEL=
AI_DAILY_LIMIT=20
