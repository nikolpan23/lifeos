# Used by `npm run dev:emulators`: runs the app against the local Firebase Emulator Suite.
# These are placeholder values for the emulator only; they don't point at any real project.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=1
NEXT_PUBLIC_FIREBASE_API_KEY=emulator-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=127.0.0.1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-lifeos
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:emulator
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
